[Unit]
Description=Secret Bridge browser paste worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/openclaw-secret-bridge
EnvironmentFile=%h/.config/secret-bridge/worker.env
ExecStart=/usr/bin/env node %h/openclaw-secret-bridge/worker.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
