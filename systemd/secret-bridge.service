[Unit]
Description=Secret Bridge web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secret-bridge
WorkingDirectory=/opt/secret-bridge
EnvironmentFile=/etc/secret-bridge.env
ExecStart=/usr/bin/env node /opt/secret-bridge/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/secret-bridge

[Install]
WantedBy=multi-user.target
